# ============================================
# NIFTY Trading Terminal - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys

# Twelve Data API Key (FREE: 800 credits/day)
# Get at: https://twelvedata.com/register
VITE_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Alpha Vantage API Key (FREE: 25 requests/day)
# Get at: https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub API Key (FREE: 60 calls/minute)
# Get at: https://finnhub.io/register
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# ── AI Predictions (server-side only — NO VITE_ prefix, never sent to the browser) ──
# One is enough; used in this order. Groq is free: https://console.groq.com/keys
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# App Settings
VITE_REFRESH_INTERVAL=30000
VITE_USE_MOCK_DATA=true

# ── Groww Trading API (server-side only — NO VITE_ prefix) ──
# Subscribe: https://groww.in/user/profile/trading-apis  | Keys: https://groww.in/trade-api/api-keys
# TOTP flow: used when both TOTP values below are set.
# Approval flow: paste API key + secret, and approve the key daily on the keys page.
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# ── Order placement (server/trading.js) ──
# The app always starts in PAPER mode. LIVE also needs a typed confirmation in the Trade page.
TRADING_LIVE_ENABLED=false
# Max lots per order
TRADE_MAX_LOTS=1
# ₹ lost if the stop-loss hits — bigger orders are refused
TRADE_MAX_LOSS_PER_TRADE=2000
# ₹ — no new entries once today's P&L is this far down
TRADE_DAILY_LOSS_LIMIT=5000
# Starting cash for the paper account
TRADE_PAPER_CAPITAL=100000

# ── Deployment (server/index.js on Railway) ──
# Login password for the whole app. REQUIRED in production — the server refuses to
# start without it. Leave empty locally (the app is then reachable only from this machine).
APP_PASSWORD=
# Optional: separate key for login cookies (otherwise derived from APP_PASSWORD)
SESSION_SECRET=
# Optional: site address(es) allowed to place orders, comma-separated, e.g. https://your-site.netlify.app
ALLOWED_ORIGINS=
# Where the server keeps its cache, paper account and order brackets (Railway volume: /data)
DATA_DIR=
